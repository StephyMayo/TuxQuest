# Copia este archivo como .env.local y reemplaza los valores vacíos por los de TU proyecto
# (Supabase > Project Settings > API). No existe una URL común para todos los proyectos.
# Si lo dejas vacío, TuxQuest funciona en modo demo y guarda los datos en este navegador.
# Usa la publishable key (o la antigua anon key); nunca pongas aquí la service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
